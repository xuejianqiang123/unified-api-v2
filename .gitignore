# Auth & secrets
auths/
data/
*.key
*.pem
*.env
.env
.env.*

# Binaries (anchored to repo root only — bare "login"/"credit" would also ignore cmd/login/, cmd/credit/)
/login
/credit
/wb2api
/signin_bin
/login.exe
/credit.exe
/wb2api.exe
/signin_bin.exe

# Config with secrets (use config.example.json)
config.json

# Build artifacts
*.tmp
__pycache__/

# 运行时产物（API Key / 进程号 / 日志 / 工具草稿目录）
# 为什么显式列 .apikey：它不是 config.json 的别名，而是 login.sh 等工具单独落盘的密钥文件，
# 不写进这里会被 git add -A 直接提交（含明文 api_key）。
.apikey
.server.pid
wb2api.pid
*.log
draft_*_folder/

# Backups (contains auth tokens)
backups/

# IDE
.idea/
.vscode/
LOOP.md
PLAN.md
SPEC.md
docs/

# 设计/计划文档（但 README.md 与 go:embed 依赖的提示词文件必须进版本库）
*.md
!README.md
!internal/prompt/defaultprompt.md

# ===== 统一网关（unified-api-v2）专属 =====

# 下游密钥存储：dbserver 首次启动自动生成，内含明文 sk- 密钥，绝不入库
keys.json

# 内化的 doubao provider 运行配置：config.json 含 api_keys/admin_token，
# accounts.json 含完整登录 Cookie，两者都绝不能入库
/doubao2api/

# 网关二进制与 Windows 编辑器备份文件
*.exe
*.exe~
/unified-api-v2

# 运行期用量/统计（含请求明细与上游账号名）
usage*.jsonl
usage_checkin.jsonl

# 配置文件备份（旧版本可能残留明文密钥）
*.bak
*.bak-*
*.bak.*

# ===== loomy provider =====
# loomy/accounts.json 含完整 loomy_web_session Cookie（等价于账号密码），
# conversations.json 含上游会话 ID，两者都是运行期数据，绝不入库。
/loomy/

# ===== vendor 进来的 Trae provider =====
# 只提交源码（src/ 与依赖清单）；虚拟环境 53MB，data/ 含账号与缓存。
/trae/.venv/
/trae/data/

# 计划任务备份（导出的 XML 含启动命令与工作目录）
/task-backup/

# 一次性调试产物（例如扫码验证时的二维码图片）
/qr_web.png

